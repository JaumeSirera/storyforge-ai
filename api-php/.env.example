# Copia este archivo como .env (una carpeta por encima de public/) y rellénalo.

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xandralyze
DB_USER=xandralyze
DB_PASS=

# Identidad: OPCIONAL. La aplicación envía la URL y la clave pública de
# Lovable Cloud en cada petición (cabeceras X-Identity-Url / X-Identity-Key).
# Solo rellénalos si tu instalación no recibe esas cabeceras (p. ej. pruebas
# directas con curl); entonces la API usará estos valores como respaldo.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clave compartida entre la app y esta API (cabecera X-App-Token).
# Debe ser idéntica a la guardada en la aplicación.
APP_TOKEN=

# Orígenes permitidos, separados por comas.
ALLOWED_ORIGINS=https://xandralyze.com,https://www.xandralyze.com

# Cuentas propias: clave para firmar los tokens de sesión (64 caracteres
# aleatorios). Debe coincidir con el valor guardado en la aplicación.
AUTH_JWT_SECRET=

# Carpeta donde se guardan los archivos subidos (fuera de la carpeta pública).
FILES_DIR=

# Correo saliente (fase B): buzón SMTP del hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contacto@xandralyze.com
SMTP_FROM_NAME=Xandralyze

# IA (fase C): la aplicación llama a /api/v1/ai/... y esta API reenvía la
# petición al proveedor con estas claves, que nunca salen del servidor.
GEMINI_API_KEY=
OPENAI_API_KEY=
