# Copia este archivo como .env (una carpeta por encima de public/) y rellénalo.

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xandralyze
DB_USER=xandralyze
DB_PASS=

# Identidad: se usa para saber a qué usuario pertenece cada token.
# Son los mismos valores públicos que ya usa la aplicación.
SUPABASE_URL=https://mcwrtuciwqttwbizqszr.supabase.co
SUPABASE_ANON_KEY=

# Clave compartida entre la app y esta API (cabecera X-App-Token).
# Genera una cadena larga y aleatoria y guarda la misma en la app.
APP_TOKEN=

# Orígenes permitidos, separados por comas.
ALLOWED_ORIGINS=https://xandralyze.com,https://www.xandralyze.com
